{
  "name": "@mnemosyne-plugins/mnemo-law",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Local laws in memory: pick a US city or county, MnemoLaw reads its ordinances from LOCUS v1 (UC Berkeley, CC BY-NC-4.0) on Hugging Face by byte range and writes them into its own vault. The cartridge ships no law data.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:cartridge": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mnemosyne_os/cartridge-sdk": "workspace:*",
    "hyparquet": "1.31.2",
    "hyparquet-compressors": "1.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mnemosyne-OS/MnemoLaw"
  }
}
